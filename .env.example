# Datos de tu proyecto de Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Si conectaste Supabase desde Vercel Storage (integración nueva), Vercel ya
# te carga solo STORAGE_SUPABASE_URL y NEXT_PUBLIC_STORAGE_SUPABASE_ANON_KEY:
# el proyecto los detecta automáticamente, no hace falta que dupliques nada.

# Clave "service_role" de Supabase. Esta NUNCA se auto-genera desde Vercel
# Storage: hay que copiarla a mano desde el panel real de Supabase
# ("Open in Supabase" > Settings > API > service_role, "Reveal").
# NUNCA se usa en el navegador, solo en las rutas /app/api (servidor).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Cadena secreta cualquiera, larga y aleatoria, para firmar la sesión
# del panel de administrador. Generála vos mismo (ej: openssl rand -hex 32).
ADMIN_JWT_SECRET=cambiar-por-una-cadena-larga-y-aleatoria
