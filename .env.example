# Datos de tu proyecto de Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Clave "service_role" de Supabase. NUNCA se usa en el navegador,
# solo en las rutas /app/api (servidor). No lleva NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Cadena secreta cualquiera, larga y aleatoria, para firmar la sesión
# del panel de administrador. Generála vos mismo (ej: openssl rand -hex 32).
ADMIN_JWT_SECRET=cambiar-por-una-cadena-larga-y-aleatoria
